{
    "name": "mharj-channels",
    "version": "0.0.4",
    "description": "channels",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
        },
        "default": "./dist/index.mjs"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "prepublishOnly": "npm run build",
        "test": "vitest test --typecheck --run --no-isolate --coverage",
        "lint": "biome check",
        "validate": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mharj/mharj-channels.git"
    },
    "keywords": [
        "channel"
    ],
    "author": "mharj",
    "license": "LGPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/mharj/mharj-channels/issues"
    },
    "homepage": "https://github.com/mharj/mharj-channels#readme",
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^24.19.1",
        "@vitest/coverage-v8": "^5.0.3",
        "c8": "^12.0.0",
        "tsdown": "^0.23.0",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    },
    "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
